<?xml version="1.0" encoding="utf-8"?>
<!--
  BettBox 风格的卡片底：圆角 18dp + 1dp 描边，不用阴影。
  深浅色都靠 clashOutline 这一层描边分层，所以两种主题下观感一致。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/clashSurfaceVariant" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/clashOutline" />
</shape>
