<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.ScriptEditorDesign" />
        <variable
            name="surface"
            type="com.github.kr328.clash.design.ui.Surface" />
        <variable
            name="dirty"
            type="boolean" />
        <variable
            name="empty"
            type="boolean" />

        <import type="android.view.View" />
        <import type="com.github.kr328.clash.design.ScriptEditorDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{surface.insets.start}"
        android:paddingEnd="@{surface.insets.end}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="@{(float) surface.insets.top + @dimen/toolbar_height}"
            android:paddingBottom="@{surface.insets.bottom}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:letterSpacing="0.08"
                android:text="@string/script_editor_mode"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/script_editor_page_hint"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/editor_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@{dirty ? @string/script_editor_status_unsaved : @string/script_editor_status_saved}"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/editor_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/script_editor_empty_state"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="@{empty ? View.VISIBLE : View.GONE}" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/clashSurfaceVariant"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/clashOutline"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/script_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="@string/script_editor_placeholder"
                    android:includeFontPadding="false"
                    android:inputType="text|textMultiLine|textNoSuggestions"
                    android:lineSpacingExtra="2dp"
                    android:padding="16dp"
                    android:scrollbars="vertical"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:importantForAutofill="no"
                    android:accessibilityLiveRegion="none" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="2dp"
                android:text="@string/script_editor_save_hint"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <com.github.kr328.clash.design.view.ActivityBarLayout
            android:id="@+id/activity_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@{surface.insets.top}">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/item_tailing_margin">

                <include
                    layout="@layout/common_activity_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/editor_save_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editor_save_action"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:enabled="@{dirty}"
                    android:minHeight="40dp"
                    android:onClick="@{() -> self.request(Request.Save)}"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </RelativeLayout>
        </com.github.kr328.clash.design.view.ActivityBarLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
