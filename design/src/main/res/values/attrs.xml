<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="fullScreenDialogTheme" format="reference" />

    <attr name="colorClashStopped" format="color" />
    <attr name="colorControlDisabled" format="color" />
    <attr name="colorLogo" format="color" />
    <attr name="clashSurfaceVariant" format="color" />
    <attr name="clashSelectedSurface" format="color" />
    <attr name="clashOutline" format="color" />

    <attr name="enabled" format="boolean" />
    <attr name="text" format="string" />
    <attr name="subtext" format="string" />
    <attr name="icon" format="reference" />
    <attr name="color" format="color" />
    <attr name="placeholder" format="string" />
    <attr name="title" format="string" />

    <declare-styleable name="LargeActionCard">
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="LargeActionLabel">
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="ActionLabel">
        <attr name="enabled" />
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="ActionTextField">
        <attr name="enabled" />
        <attr name="icon" />
        <attr name="title" />
        <attr name="text" />
        <attr name="placeholder" />
    </declare-styleable>

    <declare-styleable name="Clickable">
        <attr name="android:focusable" />
        <attr name="android:clickable" />
        <attr name="android:background" />
        <attr name="android:foreground" />
    </declare-styleable>

    <!-- 首页网格里一张卡片的落位：占几列几行（以「档」计，1 档 = 4 列）。 -->
    <declare-styleable name="HomeGridTile">
        <attr name="tileKey" format="string" />
        <attr name="tileSpanW" format="integer" />
        <attr name="tileSpanH" format="integer" />
        <attr name="tileMinSpanW" format="integer" />
        <attr name="tileMinSpanH" format="integer" />
    </declare-styleable>
</resources>
